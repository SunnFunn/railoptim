/target
/tmp
/app/bin/*
!/app/bin/.gitkeep
web-ui/node_modules/
# dist собирается на машине с npm и коммитится в git (оффлайн prod без Node)
web-ui/dist/**/*.map
__pycache__/
*.py[cod]
# /logs
.cursorrules
# *.log
data/stations/cache/
data/stations/*.parquet
data/stations/fetch_report.json
data/stations/build_report.json
data/stations/unmatched_esr6.csv
data/stations/osm_esr_index.parquet
data/stations/osm_index_report.json
data/stations/sbin_esr_index.parquet
data/stations/sbin_index_report.json
data/stations/stations_geo.sqlite
data/stations/cross_border_esr6_conflicts.csv
data/map/*.pmtiles
data/map/*.partial
data/map/ru_cis_download.log
data/map/verify_report.txt
# data/map/railways_voronoi_report.json

# Supermap (https://supermap.zatramvaj.su, WFS wms.zatramvaj.su) — сырьё с сайта, не коммитить.
# В git только отфильтованный data/map/railways_zones.geojson (см. scripts/map/fetch_supermap_rworgs.py).
data/map/supermap_rworgs_raw.geojson
data/map/supermap_*_raw.geojson
data/map/supermap_*_raw.json
data/map/railways_zones_report.json
# прочие возможные скачивания с Суперкарты (stations.geojson и т.п.), если появятся локально:
data/map/supermap_stations*.geojson
data/map/supermap_wfs_*.geojson
scripts/map/.venv/
scripts/map/.uv-cache/