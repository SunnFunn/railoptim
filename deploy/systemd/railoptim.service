[Unit]
Description=Railoptim batch optimization: полный пул вагонов (периоды 1 и 10)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=atretyakov
Group=atretyakov
WorkingDirectory=/home/atretyakov/railoptim
# run.sh prod: сбор данных, обновление БД отстоя, оптимизация по периодам 1 и 10.
# Отчёт: tmp/result_YYYYMMDD_HHMMSS.json, чекпоинт tmp/checkpoint_*.xlsx.
ExecStart=/bin/bash /home/atretyakov/railoptim/run.sh prod
TimeoutSec=3600
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
